# Site Configuration
# Full reference: https://github.com/uniweb/docs/blob/main/reference/site-configuration.md

name: {{projectName}}

# The tab icon, a file in public/. Every page links it, wherever the site is served.
favicon: /favicon.svg

{{#if foundationRef}}
foundation: {{{foundationRefYaml}}}

{{/if}}
index: home

# ─── Page Ordering ─────────────────────────────────────────────────────────────
# Control which pages appear in navigation and in what order.
# pages: [home, about, ...]        # home first, about second, rest auto-discovered
# pages: [home, ..., contact]      # home first, contact last, rest in middle
# pages: [home, about]             # Strict: only these pages in nav (others still built)
# Or just set the homepage and auto-discover the rest:
# index: home

# ─── Content Paths ─────────────────────────────────────────────────────────────
# Mount external content directories into your site's page tree.
# Paths resolve relative to this file.
#
# paths:
#   pages/docs: ../../../docs       # Mount docs repo at /docs route
#   pages/blog: ../../blog-content  # Mount blog content at /blog route
#   layout: ./custom-layout         # Custom layout directory
#   records: ./data                 # Where this site's records live
#
# A mount is one level under pages/. To give a mounted route a layout or a title,
# add a local folder for it (pages/docs/) holding a folder.yml. Whatever that stub
# leaves unset comes from the mounted directory's own folder.yml, so it need only say
# what differs. A page.yml with markdown of its own there makes a real page above the
# mounted pages. A local subfolder isn't read: its pages would come from the mount.
#
# A `pages/<segment>:` mount goes wherever the site goes: builds, `uniweb export`
# and `uniweb deploy --host <adapter>`, and `uniweb push` / `uniweb publish`,
# which send the mounted pages as they are on disk — update a mounted repository
# before you publish. A pull never writes into a mount.

# ─── Structured Content ───────────────────────────────────────────────────────
# Three things, and they are separate on purpose:
#
#   records/{schema}/    your site's records — every file here is one. The folder
#                        names their data schema:
#                          records/article/        → @/article  (your foundation's)
#                          records/std/person/     → @std/person
#                        A file whose name starts with `_` is not a record.
#   records/folder.yml   OPTIONAL — sorts records into folders a query can slice
#                        with `scope:`. The one file in records/ that is not a
#                        record. Most sites have none:
#                            - folder: archive
#                              records:
#                                - article/2025-*.md
#   queries.yml          HOW CONTENT IS REACHED — named queries over those records:
#                            recent:
#                              schema: '@/article'
#                              sort: date desc
#                              limit: 10
#
# Pages and sections then name a query: `query: recent`, or
# `fetch: { query: recent, limit: 3 }` for anything more.
#
# You can also keep queries here instead of in queries.yml:
#
# queries:
#   articles:
#     schema: '@/article'
#     sort: date desc                    # Sort by frontmatter field
#   team:
#     url: https://api.example.com/team  # Remote JSON instead of your records

# ─── Extensions ────────────────────────────────────────────────────────────────
# Load additional foundations (section types) via URL.
# extensions:
#   - https://cdn.example.com/effects/foundation.js

# ─── Layout ────────────────────────────────────────────────────────────────────
# Override the foundation's default layout per-site.
# layout: DocsLayout
# Or per-page in page.yml:  layout: { name: MarketingLayout, hide: [left] }

# ─── Base Path ─────────────────────────────────────────────────────────────────
# For subdirectory deployments (e.g., https://example.com/docs/).
# base: /docs/

build:
  prerender: true
